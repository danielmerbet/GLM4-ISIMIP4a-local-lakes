&glm_setup
   sim_name = 'GLMSimulation'
   max_layers = 9
   min_layer_vol = 0.1
   min_layer_thick = 0.15
   max_layer_thick = 1
   density_model = 1
/
&light
   light_mode = 0
   n_bands = 4
   light_extc = 1, 0.5, 2, 4
   energy_frac = 0.51, 0.45, 0.035, 0.005
   Benthic_Imin = 10
   Kw = 1.855423142
/
&mixing
   surface_mixing = 1
   coef_mix_conv = 0.1029203663
   coef_wind_stir = 0.23
   coef_mix_shear = 0.3
   coef_mix_turb = 0.5428192061
   coef_mix_KH = 0.3
   coef_mix_hyp = 1.11641324
   deep_mixing = 2
   diff = 0
/
&morphometry
   lake_name = 'Villasjon'
   latitude = 68.35
   longitude = 19.05
   bsn_len = 657.9525
   bsn_wid = 328.9762
   bsn_vals = 2
   H = 350, 351
   A = 0, 170000
   crest_elev = 351
/
&time
   timefmt = 2
   start = '1881-01-01 00:00:00'
   stop = '2026-01-01 00:00:00'
   dt = 3600
   num_days = 730
   timezone = 0
/
&output
   out_dir = 'output'
   out_fn = 'output'
   nsave = 24
   csv_lake_fname = 'lake'
/
&init_profiles
   lake_depth = 1
   num_depths = 3
   the_depths = 0.1, 0.3, 0.5
   the_temps = 10.29, 10.29, 10.32
   the_sals = 0, 0, 0
/
&meteorology
   met_sw = .true.
   lw_type = 'LW_IN'
   rain_sw = .false.
   atm_stab = 0
   catchrain = .false.
   rad_mode = 1
   albedo_mode = 1
   cloud_mode = 4
   meteo_fl = 'meteo_file.csv'
   subdaily = .false.
   wind_factor = 1.49991647
   sw_factor = 1.271859733
   lw_factor = 1
   at_factor = 1
   rh_factor = 1
   rain_factor = 1
   cd = 0.0013
   ce = 0.0013
   ch = 0.0013
   rain_threshold = 0.01
   runoff_coef = 0.3
   time_fmt = 'YYYY-MM-DD hh:mm:ss'
/
&inflow
   num_inflows = 1
   names_of_strms = 'evapcomp'
   subm_flag = .false.
   strm_hf_angle = 65
   strmbd_slope = 2
   strmbd_drag = 0.016
   inflow_factor = 1
   inflow_fl = 'inflow_evapcomp.csv'
   inflow_varnum = 3
   inflow_vars = 'FLOW', 'SALT', 'TEMP'
/
&outflow
   num_outlet = 0
/
&snowice
   snow_albedo_factor = 1
   snow_rho_max = 500
   snow_rho_min = 100
/
