&glm_setup
   sim_name = 'GLMSimulation'
   max_layers = 152
   min_layer_vol = 0.1
   min_layer_thick = 0.15
   max_layer_thick = 1
   density_model = 1
/
&light
   light_mode = 0
   n_bands = 4
   light_extc = 1, 0.5, 2, 4
   energy_frac = 0.51, 0.45, 0.035, 0.005
   Benthic_Imin = 10
   Kw = 0.6571053362
/
&mixing
   surface_mixing = 1
   coef_mix_conv = 0.112995939
   coef_wind_stir = 0.23
   coef_mix_shear = 0.3
   coef_mix_turb = 0.4715209898
   coef_mix_KH = 0.3
   coef_mix_hyp = 0.9480902583
   deep_mixing = 2
   diff = 0
/
&morphometry
   lake_name = 'Mozhaysk'
   latitude = 55.59
   longitude = 35.82
   bsn_len = 7763.708
   bsn_wid = 3881.854
   bsn_vals = 12
   H = 162, 163, 165, 167, 169, 171, 173, 175, 177, 179, 181, 183
   A = 0, 10000, 160000, 1420000, 3220000, 7410000, 11610000, 14180000, 16590000, 1.9e+07, 21380000, 23670000
   crest_elev = 183
/
&time
   timefmt = 2
   start = '1881-01-01 00:00:00'
   stop = '2026-01-01 00:00:00'
   dt = 3600
   num_days = 730
   timezone = 0
/
&output
   out_dir = 'output'
   out_fn = 'output'
   nsave = 24
   csv_lake_fname = 'lake'
/
&init_profiles
   lake_depth = 21
   num_depths = 7
   the_depths = 0.1, 1, 2, 3, 5, 7, 10
   the_temps = 14.49, 14.28, 13.86, 13.19, 12.25, 10.68, 9.39
   the_sals = 0, 0, 0, 0, 0, 0, 0
/
&meteorology
   met_sw = .true.
   lw_type = 'LW_IN'
   rain_sw = .false.
   atm_stab = 0
   catchrain = .false.
   rad_mode = 1
   albedo_mode = 1
   cloud_mode = 4
   meteo_fl = 'meteo_file.csv'
   subdaily = .false.
   wind_factor = 1.494461965
   sw_factor = 1.103154905
   lw_factor = 1
   at_factor = 1
   rh_factor = 1
   rain_factor = 1
   cd = 0.0013
   ce = 0.0013
   ch = 0.0013
   rain_threshold = 0.01
   runoff_coef = 0.3
   time_fmt = 'YYYY-MM-DD hh:mm:ss'
/
&inflow
   num_inflows = 1
   names_of_strms = 'evapcomp'
   subm_flag = .false.
   strm_hf_angle = 65
   strmbd_slope = 2
   strmbd_drag = 0.016
   inflow_factor = 1
   inflow_fl = 'inflow_evapcomp.csv'
   inflow_varnum = 3
   inflow_vars = 'FLOW', 'SALT', 'TEMP'
/
&outflow
   num_outlet = 0
/
&snowice
   snow_albedo_factor = 1
   snow_rho_max = 500
   snow_rho_min = 100
/
