&glm_setup
   sim_name = 'GLMSimulation'
   max_layers = 69
   min_layer_vol = 0.1
   min_layer_thick = 0.15
   max_layer_thick = 1
   density_model = 1
/
&light
   light_mode = 0
   n_bands = 4
   light_extc = 1, 0.5, 2, 4
   energy_frac = 0.51, 0.45, 0.035, 0.005
   Benthic_Imin = 10
   Kw = 1.398547635
/
&mixing
   surface_mixing = 1
   coef_mix_conv = 0.1796168326
   coef_wind_stir = 0.23
   coef_mix_shear = 0.3
   coef_mix_turb = 0.473137033
   coef_mix_KH = 0.3
   coef_mix_hyp = 0.5246924199
   deep_mixing = 2
   diff = 0
/
&morphometry
   lake_name = 'NohipaloMustjarv'
   latitude = 57.93
   longitude = 27.34
   bsn_len = 734.5878
   bsn_wid = 367.2939
   bsn_vals = 10
   H = 52.1, 53, 54, 55, 56, 57, 58, 59, 60, 61
   A = 0, 1623, 18981, 40147, 72375, 105318, 138539, 172089, 204623, 211908
   crest_elev = 61
/
&time
   timefmt = 2
   start = '1881-01-01 00:00:00'
   stop = '2026-01-01 00:00:00'
   dt = 3600
   num_days = 730
   timezone = 0
/
&output
   out_dir = 'output'
   out_fn = 'output'
   nsave = 24
   csv_lake_fname = 'lake'
/
&init_profiles
   lake_depth = 8.9
   num_depths = 7
   the_depths = 0.5, 1, 2, 3, 4, 5, 6
   the_temps = 3.47, 3.48, 3.67, 3.77, 3.63, 3.95, 4.02
   the_sals = 0, 0, 0, 0, 0, 0, 0
/
&meteorology
   met_sw = .true.
   lw_type = 'LW_IN'
   rain_sw = .false.
   atm_stab = 0
   catchrain = .false.
   rad_mode = 1
   albedo_mode = 1
   cloud_mode = 4
   meteo_fl = 'meteo_file.csv'
   subdaily = .false.
   wind_factor = 0.757250734
   sw_factor = 0.9531526937
   lw_factor = 1
   at_factor = 1
   rh_factor = 1
   rain_factor = 1
   cd = 0.0013
   ce = 0.0013
   ch = 0.0013
   rain_threshold = 0.01
   runoff_coef = 0.3
   time_fmt = 'YYYY-MM-DD hh:mm:ss'
/
&inflow
   num_inflows = 1
   names_of_strms = 'evapcomp'
   subm_flag = .false.
   strm_hf_angle = 65
   strmbd_slope = 2
   strmbd_drag = 0.016
   inflow_factor = 1
   inflow_fl = 'inflow_evapcomp.csv'
   inflow_varnum = 3
   inflow_vars = 'FLOW', 'SALT', 'TEMP'
/
&outflow
   num_outlet = 0
/
&snowice
   snow_albedo_factor = 1
   snow_rho_max = 500
   snow_rho_min = 100
/
