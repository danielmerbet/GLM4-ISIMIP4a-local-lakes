&glm_setup
   sim_name = 'GLMSimulation'
   max_layers = 131
   min_layer_vol = 0.1
   min_layer_thick = 0.15
   max_layer_thick = 1
   density_model = 1
/
&light
   light_mode = 0
   n_bands = 4
   light_extc = 1, 0.5, 2, 4
   energy_frac = 0.51, 0.45, 0.035, 0.005
   Benthic_Imin = 10
   Kw = 0.6137691639
/
&mixing
   surface_mixing = 1
   coef_mix_conv = 0.1535866318
   coef_wind_stir = 0.23
   coef_mix_shear = 0.3
   coef_mix_turb = 0.5990142254
   coef_mix_KH = 0.3
   coef_mix_hyp = 0.282553843
   deep_mixing = 2
   diff = 0
/
&morphometry
   lake_name = 'Rappbodep'
   latitude = 51.71
   longitude = 10.8
   bsn_len = 745.841
   bsn_wid = 372.9205
   bsn_vals = 18
   H = 516, 517, 518, 519, 520, 521, 522, 523, 524, 525, 526, 527, 528, 529, 530, 531, 532, 533
   A = 21.91222, 630.70123, 1806.91162, 6377.82422, 11147.95898, 17563.41211, 26109.10547, 36142.125, 48890.32813, 61616.53125, 74849.11719, 89551.82031, 105016.0547, 116929.6328, 130870.8359, 147309.4375, 173050.9531, 218450.1719
   crest_elev = 533
/
&time
   timefmt = 2
   start = '1881-01-01 00:00:00'
   stop = '2026-01-01 00:00:00'
   dt = 3600
   num_days = 730
   timezone = 0
/
&output
   out_dir = 'output'
   out_fn = 'output'
   nsave = 24
   csv_lake_fname = 'lake'
/
&init_profiles
   lake_depth = 17
   num_depths = 20
   the_depths = 0, 0.84, 1.68, 2.53, 3.37, 4.21, 5.05, 5.89, 6.74, 7.58, 8.42, 9.26, 10.11, 10.95, 11.79, 12.63, 13.47, 14.32, 15.16, 16
